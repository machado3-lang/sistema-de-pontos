# ── PostgreSQL (Railway) ────────────────────────────────────────────────────
# No Railway, copie a DATABASE_URL do plugin PostgreSQL.
DATABASE_URL=
PGSSL=false
PG_POOL_MAX=10

# ── Autenticação do PontoCloud ──────────────────────────────────────────────
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TTL_HOURS=8
API_TOKEN=
ADMIN_USER=admin
ADMIN_PASSWORD=
MOBILE_TOKEN_SECRET=
CORS_ORIGINS=http://localhost:5173,http://localhost

# ── Frontend (build) ────────────────────────────────────────────────────────
# Ainda usado pelo frontend atual. Será removido na Fase 4 (src/api.js).
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
VITE_PONTOCLOUD_URL=

# ── Supabase (legado — apenas durante a migração de dados) ──────────────────
# Não é mais usado pelo backend novo. Mantido para exportar dados antigos.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# ── Portas (opcional) ───────────────────────────────────────────────────────
PONTOCLOUD_PORT=3100
PONTOWEB_PORT=80
