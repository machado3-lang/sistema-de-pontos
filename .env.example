# ── PostgreSQL (Railway) ────────────────────────────────────────────────────
# No Railway, copie a DATABASE_URL do plugin PostgreSQL.
DATABASE_URL=
PGSSL=false
PG_POOL_MAX=10

# ── Autenticação do PontoCloud ──────────────────────────────────────────────
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TTL_HOURS=8
API_TOKEN=
ADMIN_USER=admin
ADMIN_PASSWORD=
MOBILE_TOKEN_SECRET=
# Criptografia das credenciais de REP (AES-256-GCM)
REP_SECRET=

# Conexão com REPs (Railway → rede local)
# Vazio = conecta direto no IP do REP (backend on-premises/dev).
IZCLOUD_URL=
IZCLOUD_TOKEN=
REP_TIMEOUT_MS=15000

CORS_ORIGINS=http://localhost:5173,http://localhost

# ── Frontend (build) ────────────────────────────────────────────────────────
# Vazio = usa /api via proxy (dev/Docker). Em deploy separado, informe a URL do backend.
VITE_PONTOCLOUD_URL=

# ── Portas (opcional) ───────────────────────────────────────────────────────
PONTOCLOUD_PORT=3100
PONTOWEB_PORT=80
